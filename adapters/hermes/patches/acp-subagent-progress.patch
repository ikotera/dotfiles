@@ -0,0 +1,130 @@
+"""Wire-facing regression tests for live delegate_task progress in the gateway viewer."""
+import asyncio
+from unittest.mock import AsyncMock
+
+import pytest
+
+from acp_adapter.gateway_server import GatewayACPAgent
+
+
+@pytest.fixture
+def viewer():
+    agent = GatewayACPAgent()
+    agent._conn = AsyncMock()
+    return agent
+
+
+async def emit(agent, kind, *, sid="s", aid="a", **payload):
+    await agent._project({"session_id": sid, "admission_id": aid, "type": kind, "payload": payload})
+
+
+async def start(agent, call_id, **kw):
+    await emit(agent, "tool.start", tool_call_id=call_id, tool_name="delegate_task", **kw)
+
+
+def updates(agent):
+    return [c.kwargs["update"].model_dump(by_alias=True, exclude_none=True)
+            for c in agent._conn.session_update.await_args_list]
+
+
+def text(update):
+    return update["content"][0]["content"]["text"]
+
+
+@pytest.mark.asyncio
+async def test_progress_updates_existing_card(viewer):
+    await start(viewer, "parent")
+    await emit(viewer, "subagent.tool", task_index=1, tool_name="terminal", tool_preview="ls -la")
+    update = updates(viewer)[-1]
+    assert update["sessionUpdate"] == "tool_call_update"
+    assert update["toolCallId"] == "parent" and update["status"] == "in_progress"
+    assert text(update) == "#2 ▸ terminal: ls -la"
+
+
+@pytest.mark.asyncio
+async def test_burst_is_coalesced_bounded_and_flushed_on_child_completion(viewer):
+    await start(viewer, "parent")
+    await emit(viewer, "subagent.start", goal="inspect")
+    for i in range(15):
+        await emit(viewer, "subagent.tool", tool_name="terminal", text=f"cmd{i}")
+    assert len(updates(viewer)) == 2  # start card + first live snapshot
+    await emit(viewer, "subagent.complete", status="completed", duration_seconds=34)
+    lines = text(updates(viewer)[-1]).splitlines()
+    assert len(lines) == 12 and lines[0].endswith("cmd4")
+    assert lines[-1] == "#1 ✓ completed (34s)"
+    assert updates(viewer)[-1]["status"] == "in_progress"
+
+
+@pytest.mark.asyncio
+async def test_idle_trailing_snapshot_and_redaction(viewer):
+    seen = asyncio.Event()
+    async def on_update(session_id, update):
+        if update.content and "💭" in str(update.content):
+            seen.set()
+    viewer._conn.session_update.side_effect = on_update
+    await start(viewer, "parent")
+    await emit(viewer, "subagent.spawn_requested", goal="inspect")
+    secret = "sk-" + "x" * 48
+    await emit(viewer, "subagent.thinking", text=f"OPENAI_API_KEY={secret}\n" + "z" * 120)
+    await asyncio.wait_for(seen.wait(), timeout=3)
+    lines = text(updates(viewer)[-1]).splitlines()
+    assert len(lines) == 2 and "inspect" in lines[0]
+    assert secret not in lines[1] and len(lines[1]) <= len("#1 💭 ") + 80
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("close", ["tool.complete", "message.complete"])
+async def test_close_flushes_pending_and_background_never_borrows_a_card(viewer, close):
+    await start(viewer, "parent")
+    await emit(viewer, "subagent.tool", tool_name="read_file")
+    await emit(viewer, "subagent.progress", text="read_file, terminal")
+    await emit(viewer, close, tool_call_id="parent")
+    assert "read_file, terminal" in text(updates(viewer)[-2])
+    assert updates(viewer)[-1]["status"] in {"failed", "completed"}
+    await start(viewer, "new", aid="next")
+    before = len(updates(viewer))
+    for aid in [None, "a"]:
+        await emit(viewer, "subagent.tool", aid=aid, tool_name="stale")
+    assert len(updates(viewer)) == before
+    assert not viewer._subagent_cards
+
+
+@pytest.mark.asyncio
+async def test_card_routing_and_projection_failure_isolation(viewer):
+    await start(viewer, "first")
+    await start(viewer, "second")
+    await start(viewer, "other", sid="another")
+    await emit(viewer, "subagent.tool", tool_name="read_file")
+    assert updates(viewer)[-1]["toolCallId"] == "second"
+    await emit(viewer, "subagent.tool", parent_tool_call_id="first", tool_name="terminal")
+    assert updates(viewer)[-1]["toolCallId"] == "first"
+    before = len(updates(viewer))
+    await emit(viewer, "subagent.tool", parent_tool_call_id="closed")
+    await emit(viewer, "subagent.tool", task_index={})
+    assert len(updates(viewer)) == before
+    viewer._conn.session_update.side_effect = OSError("editor gone")
+    await emit(viewer, "subagent.complete", status="failed")
+    viewer._conn.session_update.side_effect = None
+    await emit(viewer, "message.delta", text="still running")
+    assert updates(viewer)[-1]["content"]["text"] == "still running"
+
+
+@pytest.mark.asyncio
+async def test_disconnect_discards_delayed_progress(viewer):
+    await start(viewer, "parent")
+    await emit(viewer, "subagent.start", goal="inspect")
+    await emit(viewer, "subagent.progress", text="pending")
+    before = len(updates(viewer))
+    await viewer._teardown()
+    assert not viewer._subagent_cards
+    assert len(updates(viewer)) == before
+
+
+@pytest.mark.asyncio
+async def test_hidden_reasoning_remains_hidden_at_the_wire(viewer):
+    from tui_gateway.tool_progress import _subagent_payload
+
+    await start(viewer, "parent")
+    payload = _subagent_payload("subagent.thinking", None, "hidden reasoning", {}, show_reasoning=False)
+    await emit(viewer, "subagent.thinking", **payload)
+    assert text(updates(viewer)[-1]) == "#1 💭 thinking"
