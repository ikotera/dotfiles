index 00000000000..9f76d8ce50c
--- /dev/null
+++ b/acp_adapter/subagent_progress.py
@@ -0,0 +1,86 @@
+"""Bounded, redacted live progress for the gateway viewer's delegate_task cards."""
+import asyncio
+import logging
+from collections import deque
+
+import acp
+
+from agent.redact import redact_sensitive_text
+
+logger = logging.getLogger(__name__)
+
+
+def progress_line(kind, p):
+    limit = 120
+    if kind in {"subagent.start", "subagent.spawn_requested"}:
+        label = "started" if kind == "subagent.start" else "queued"
+        detail = f"{label}: {p.get('goal') or p.get('text') or ''}".rstrip(": ")
+    elif kind == "subagent.tool":
+        tool = p.get("tool_name") or "tool"
+        preview = p.get("tool_preview") or p.get("text")
+        detail = f"▸ {tool}: {preview}" if preview else f"▸ {tool}"
+    elif kind == "subagent.progress":
+        detail = p.get("text") or "working"
+    elif kind == "subagent.thinking":
+        # The gateway omits text when reasoning is hidden. Never recover it from other fields.
+        detail = "💭 " + (p.get("text") or "thinking")
+        limit = len("💭 ") + 80
+    elif kind == "subagent.complete":
+        status = p.get("status") or "finished"
+        mark = "✓" if status in {"completed", "finished"} else "!"
+        seconds = p.get("duration_seconds")
+        elapsed = f" ({seconds:.0f}s)" if isinstance(seconds, (int, float)) else ""
+        detail = f"{mark} {status}{elapsed}"
+    else:
+        return None
+    # Redact before truncating: slicing a credential first can break its recognisable shape.
+    safe = " ".join(redact_sensitive_text(detail, force=True).split())
+    if len(safe) > limit:
+        safe = safe[:limit - 1] + "…"
+    return f"#{p.get('task_index', 0) + 1} {safe}"
+
+
+class ProgressCard:
+    """At most one writer per card; finish wakes the trailing send before the parent closes."""
+    def __init__(self, conn, editor_id, call_id):
+        self.conn, self.editor_id, self.call_id = conn, editor_id, call_id
+        self.lines = deque(maxlen=12)
+        self.next_send = 0.0
+        self.task = None
+        self.wake = asyncio.Event()
+        self.dirty = False
+
+    async def append(self, line, *, final, background):
+        self.lines.append(line)
+        self.dirty = True
+        ready = asyncio.get_running_loop().time() >= self.next_send
+        if self.task is None or self.task.done():
+            self.task = asyncio.create_task(self._drain())
+            background.add(self.task)
+            self.task.add_done_callback(background.discard)
+        if final or ready:
+            await self.flush()
+
+    async def flush(self):
+        if self.task is not None and not self.task.done():
+            self.wake.set()
+            await self.task
+
+    async def _drain(self):
+        loop = asyncio.get_running_loop()
+        while self.dirty:
+            delay = self.next_send - loop.time()
+            if delay > 0 and not self.wake.is_set():
+                try:
+                    await asyncio.wait_for(self.wake.wait(), delay)
+                except asyncio.TimeoutError:
+                    pass
+            self.wake.clear()
+            self.dirty = False
+            self.next_send = loop.time() + 0.5
+            try:
+                content = [acp.tool_content(acp.text_block("\n".join(self.lines)))]
+                await self.conn.session_update(session_id=self.editor_id, update=acp.update_tool_call(
+                    self.call_id, status="in_progress", content=content))
+            except Exception:  # Display only, including delayed sends outside the event pump.
+                logger.debug("ACP subagent card update failed", exc_info=True)
