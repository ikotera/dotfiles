+/// [`families`] as `(value, label)` rows for the ribbon's Font box: the value is the family name a
+/// cell stores, the label adds the family's local name when it has one in another script, e.g.
+/// `Hiragino Sans（ヒラギノ角ゴシック）`, so a Japanese name can be typed in the filter. Built once
+/// the scan has finished and kept, so the ribbon doesn't rebuild it every frame.
+pub fn family_choices() -> Vec<(String, String)> {
+    static CHOICES: OnceLock<Vec<(String, String)>> = OnceLock::new();
+    if let Some(c) = CHOICES.get() {
+        return c.clone();
+    }
+    let Some(cat) = catalog_now() else {
+        return families().into_iter().map(|f| (f.clone(), f)).collect();
+    };
+    CHOICES.get_or_init(|| choices_from(cat, families())).clone()
+}
+
+fn choices_from(cat: &[Face], families: Vec<String>) -> Vec<(String, String)> {
+    families
+        .into_iter()
+        .map(|family| {
+            let local = cat
+                .iter()
+                .filter(|f| f.family.eq_ignore_ascii_case(&family))
+                .flat_map(|f| f.names.iter())
+                .find(|n| !n.is_ascii() && !n.chars().any(|c| c.is_ascii_digit()))
+                .or_else(|| cat.iter().filter(|f| f.family.eq_ignore_ascii_case(&family)).flat_map(|f| f.names.iter()).find(|n| !n.is_ascii()));
+            let label = match local {
+                Some(l) => format!("{family}（{l}）"),
+                None => family.clone(),
+            };
+            (family, label)
+        })
+        .collect()
+}
