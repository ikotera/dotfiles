+/// macOS keeps its downloadable fonts (YuGothic, YuMincho, Osaka, Klee, Tsukushi, Kyokasho…) as
+/// MobileAsset bundles, not in a Fonts folder: the ones downloaded on demand under
+/// `/System/Library/AssetsV2/com_apple_MobileAsset_Font*` and the ones shipped with the OS under
+/// `PreinstalledAssetsV2/InstallWithOs`. Only the `…_Font*` asset folders are returned, so the scan
+/// never walks the other (firmware, dictionary) assets.
+#[cfg(not(target_arch = "wasm32"))]
+fn macos_asset_font_dirs() -> Vec<PathBuf> {
+    let mut out: Vec<PathBuf> = Vec::new();
+    for root in ["/System/Library/AssetsV2", "/System/Library/AssetsV2/PreinstalledAssetsV2/InstallWithOs"] {
+        let Ok(entries) = std::fs::read_dir(root) else { continue };
+        let mut found: Vec<PathBuf> =
+            entries.flatten().filter(|e| e.file_name().to_string_lossy().starts_with("com_apple_MobileAsset_Font")).map(|e| e.path()).collect();
+        found.sort();
+        out.extend(found);
+    }
+    out
+}
+
+/// A face's weight: the style name's when it names one (`"Bold"`, `"Light"`), else the font's own
+/// OS/2 `usWeightClass`, else 400. Japanese families name weights `W0`…`W9` (Hiragino Sans) or
+/// call every face `Regular` in its own file (YuGothic Medium/Bold), so without the OS/2 value all
+/// their faces read as 400 and the "regular" face was whichever file the scan met first, often a
+/// heavy one.
+#[cfg(not(target_arch = "wasm32"))]
+fn face_weight(style: &str, os2_weight: Option<u16>) -> f32 {
+    let named = style_weight(style);
+    if (named - 400.0).abs() >= 1.0 {
+        return named;
+    }
+    match os2_weight {
+        Some(w @ 1..=1000) => f32::from(w),
+        _ => 400.0,
+    }
+}
+
+/// The OS/2 `usWeightClass` of every face in `data`, by face index (`None` when a face has no
+/// readable OS/2 table). Damaged data yields nothing, never a panic.
+#[cfg(not(target_arch = "wasm32"))]
+fn file_weights(data: &[u8]) -> Vec<Option<u16>> {
+    use skrifa::raw::{FileRef, TableProvider};
+    let count = match FileRef::new(data) {
+        Ok(FileRef::Font(_)) => 1,
+        Ok(FileRef::Collection(c)) => c.len(),
+        Err(_) => return Vec::new(),
+    };
+    (0..count).map(|i| skrifa::FontRef::from_index(data, i).ok().and_then(|f| f.os2().ok()).map(|t| t.us_weight_class())).collect()
+}
