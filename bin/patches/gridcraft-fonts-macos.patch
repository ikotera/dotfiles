+/// The face of `faces` nearest to `target` by the CSS Fonts weight-matching rules.
+fn closest_weight<'a>(faces: &[&'a Face], target: f32) -> Option<&'a Face> {
+    let at_least = |lo: f32, hi: f32| faces.iter().filter(|f| f.weight >= lo && f.weight <= hi).min_by(|a, b| a.weight.total_cmp(&b.weight)).copied();
+    let below = |hi: f32| faces.iter().filter(|f| f.weight < hi).max_by(|a, b| a.weight.total_cmp(&b.weight).then(b.path.cmp(&a.path))).copied();
+    if (400.0..=500.0).contains(&target) {
+        at_least(target, 500.0).or_else(|| below(target)).or_else(|| at_least(500.0, f32::MAX))
+    } else if target > 500.0 {
+        at_least(target, f32::MAX).or_else(|| below(target))
+    } else {
+        below(target + 0.5).or_else(|| at_least(target, f32::MAX))
+    }
 }
 
